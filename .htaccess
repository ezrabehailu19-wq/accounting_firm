# ---------------------------------------------------------
#  Root .htaccess (Apache)
#
#  Nginx users: these rules have direct equivalents. See README.md.
# ---------------------------------------------------------

# Never list the contents of a folder that has no index file.
Options -Indexes

# Don't advertise the PHP version in response headers.
<IfModule mod_headers.c>
    Header unset X-Powered-By
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Block access to dotfiles — .env above all, which holds the database
# password. Without this rule, a misconfigured server will happily
# serve it as plain text.
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# And to anything that is configuration or data rather than a page.
<FilesMatch "\.(env|sql|log|md|ini|bak|old|sh|yml|yaml|json|lock)$">
    Require all denied
</FilesMatch>

# Default document
DirectoryIndex index.html index.php

# A friendlier 404 than the Apache default
ErrorDocument 404 /index.html
