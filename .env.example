# Copy this file to .env and fill in your real local values.
# .env is gitignored and must NEVER be committed.

DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=accounting_firm

# Email address that receives a notification whenever a new contact
# form message is submitted. Separate from any user login — this is
# just where you (the business owner) want alerts delivered.
ADMIN_NOTIFY_EMAIL=owner@example.com