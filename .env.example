# Copy this file to .env and fill in your own values.
# .env is listed in .gitignore and must never be committed.

# ---------- Database ----------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=accounting_firm
DB_USER=root
DB_PASS=

# ---------- Application ----------
# 'development' shows full errors on screen. Use 'production' on a live server.
APP_ENV=production
APP_DEBUG=false
APP_NAME="Selamawit H/Mariam"
APP_TAGLINE="Accounting & Financial Consulting"
APP_TIMEZONE=Africa/Addis_Ababa

# ---------- Business details (printed on invoices) ----------
FIRM_ADDRESS="Ureal Area, 6th Floor, Addis Ababa, Ethiopia"
FIRM_PHONE="+251 933 5831"
FIRM_EMAIL=info@yourfirm.et
FIRM_TIN=
CURRENCY=ETB
VAT_RATE=15

# ---------- Notifications ----------
# Where new contact-form requests are announced. Leave blank to disable.
ADMIN_NOTIFY_EMAIL=
MAIL_FROM=no-reply@yourfirm.et
# true  -> write mail to storage/mail.log instead of sending (use while testing)
# false -> hand off to PHP mail(), which needs a working MTA
MAIL_LOG_ONLY=true

# ---------- Uploads ----------
MAX_UPLOAD_MB=10

# ---------- Security ----------
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
RESET_TOKEN_MINUTES=30
SESSION_IDLE_MINUTES=60
PER_PAGE=15
# Only switch on when the app really is behind a reverse proxy or load
# balancer. If it isn't, X-Forwarded-For is attacker-controlled and
# turning this on defeats IP rate limiting.
TRUST_PROXY=false
