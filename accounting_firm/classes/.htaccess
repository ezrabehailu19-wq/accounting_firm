# These files are included by the application, never requested directly.
# Denying access here means a server misconfiguration that stops PHP
# from executing exposes nothing: the worst case is a 403, not the
# source of the database layer or a client's tax return in plain text.
Require all denied

# Apache 2.2 fallback
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
